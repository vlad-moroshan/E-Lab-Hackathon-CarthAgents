{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:carthagents:extraction-output:v1",
  "title": "CarthAgents extraction output",
  "description": "One input document to one JSON, preserving all reporting years. Financial values are code-parsed observations with evidence or explicit abstentions. No ground-truth generator metadata or planted annotations.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "required": [
    "schema_version",
    "meta",
    "rows",
    "findings"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fieldName": {
      "enum": [
        "ahk_open",
        "zugang",
        "abgang",
        "umbuchung",
        "zuschreibung",
        "ahk_close",
        "kum_afa_open",
        "afa_gj",
        "afa_abgang",
        "kum_afa_close",
        "bw_close",
        "bw_prev",
        "abgang_bw",
        "bew_ahk",
        "bew_wb"
      ]
    },
    "pdfPointer": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "additionalProperties": false,
      "description": "Original physical page, 1-based; [x0, top, x1, bottom] in PDF points, top-left origin. Map OCR coordinates back from any deskew/rotation."
    },
    "xlsxPointer": {
      "type": "object",
      "properties": {
        "sheet": {
          "$ref": "#/$defs/text"
        },
        "cell": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"
        }
      },
      "required": [
        "sheet",
        "cell"
      ],
      "additionalProperties": false
    },
    "pointer": {
      "oneOf": [
        {
          "$ref": "#/$defs/pdfPointer"
        },
        {
          "$ref": "#/$defs/xlsxPointer"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Normalized EUR cents; null for any abstention."
        },
        "status": {
          "enum": [
            "observed",
            "unreadable",
            "absent",
            "not_applicable",
            "uncertain"
          ]
        },
        "printed": {
          "type": "string",
          "description": "Source text, including an empty string for an observed blank-zero cell."
        },
        "raw_amount": {
          "type": "integer",
          "description": "Code-parsed signed EUR cents after unit scaling, before semantic sign normalization."
        },
        "source_unit": {
          "enum": [
            "EUR",
            "TEUR"
          ]
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "amount",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "amount": {
                "type": "integer"
              }
            },
            "required": [
              "printed",
              "raw_amount",
              "source_unit",
              "pointer"
            ]
          },
          "else": {
            "properties": {
              "amount": {
                "type": "null"
              }
            },
            "required": [
              "reason"
            ],
            "not": {
              "required": [
                "raw_amount"
              ]
            }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "doc_id": {
          "$ref": "#/$defs/text"
        },
        "format": {
          "enum": [
            "xlsx",
            "pdf",
            "scan",
            "outline"
          ]
        },
        "years": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/year"
          },
          "uniqueItems": true
        },
        "unit": {
          "enum": [
            "EUR",
            "TEUR"
          ]
        },
        "period_end": {
          "$ref": "#/$defs/date"
        },
        "company": {
          "$ref": "#/$defs/text"
        },
        "doc_type": {
          "$ref": "#/$defs/text"
        },
        "software": {
          "$ref": "#/$defs/text"
        },
        "company_code": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "doc_id",
        "format",
        "years"
      ],
      "additionalProperties": false,
      "description": "Only assigned identity and source-identifiable facts. Omit unknown optional metadata and explain uncertainty in findings; years may be empty if unknown."
    },
    "row": {
      "type": "object",
      "properties": {
        "row_id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "asset",
            "class_subtotal",
            "account_subtotal",
            "position_subtotal",
            "grand_total",
            "carry_over",
            "unknown"
          ]
        },
        "level": {
          "enum": [
            "asset",
            "account",
            "class",
            "bilanzposition",
            "unknown"
          ]
        },
        "year": {
          "anyOf": [
            {
              "$ref": "#/$defs/year"
            },
            {
              "type": "null"
            }
          ]
        },
        "year_reason": {
          "$ref": "#/$defs/text"
        },
        "kind_reason": {
          "$ref": "#/$defs/text"
        },
        "asset_no": {
          "type": [
            "string",
            "null"
          ]
        },
        "sub_no": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "hgb_position": {
          "type": [
            "string",
            "null"
          ]
        },
        "acq_date": {
          "$ref": "#/$defs/date"
        },
        "nd_months": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "required": [
        "row_id",
        "kind",
        "level",
        "year",
        "fields"
      ],
      "additionalProperties": false,
      "description": "One logical source row; kind=asset denotes a leaf, with level specifying its actual granularity. row_id is stable within this output document.",
      "allOf": [
        {
          "if": {
            "properties": {
              "year": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "year_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "kind_reason"
            ]
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/text"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "row_id": {
          "$ref": "#/$defs/text"
        },
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "field": [
          "row_id"
        ]
      }
    }
  }
}
